#!/usr/bin/env python3
"""
AUR build pipeline: reads allowlist, builds approved packages, scans with
Trivy, signs with GPG, and publishes to the pacman repo on the shared PV.

Runs in two phases (BUILD_PHASE env), so the GPG signing key is never present
in any container that executes untrusted PKGBUILD code:

  build  -- fetch PKGBUILD, Claude scan, makepkg, Trivy. Vetted artifacts are
            staged under BUILD_DIR/.staging and recorded in a manifest. NO GPG
            key is mounted in this phase. Always exits 0 (per-package failures
            are recorded) so the sign phase still publishes what passed.
  sign   -- read the manifest, GPG-sign and publish each staged artifact, prune
            the repo, push metrics. Runs in a container that has the key but
            NEVER runs PKGBUILD code.
  all    -- run build then sign in one process (local/manual use only; no
            isolation).

Exit codes (sign / all phase):
  0 -- all approved packages built and published (or already up to date)
  1 -- one or more packages failed (Claude hold, Trivy finding, build error)
"""
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
import logging
import urllib.request
from pathlib import Path

import yaml

try:
    import anthropic as _anthropic
    _HAS_ANTHROPIC = True
except ImportError:
    _HAS_ANTHROPIC = False

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
)
log = logging.getLogger(__name__)

REPO_DIR          = Path(os.environ["REPO_DIR"])      # /repo — NFS PVC
BUILD_DIR         = Path(os.environ.get("BUILD_DIR", "/build"))   # emptyDir
ALLOWLIST         = Path(os.environ.get("ALLOWLIST", "/config/allowlist.yaml"))
REPO_NAME         = os.environ.get("REPO_NAME", "aur-mirror")
GPG_KEY_ID        = os.environ.get("GPG_KEY_ID", "")  # not secret; sign phase only
FAIL_SEVS         = os.environ.get("TRIVY_FAIL_SEVERITY", "HIGH,CRITICAL")
PUSHGATEWAY_URL   = os.environ.get("PUSHGATEWAY_URL", "")
ANTHROPIC_API_KEY = os.environ.get("ANTHROPIC_API_KEY", "")
BUILD_PHASE       = os.environ.get("BUILD_PHASE", "all")  # build | sign | all

# Vetted artifacts are staged here by the build phase and consumed by the sign
# phase. Both containers share BUILD_DIR (the same per-pod emptyDir), so the
# handoff needs no extra volume. The sign phase shutil.move()s each artifact
# across to the NFS repo (cross-device copy+unlink).
STAGING_DIR = BUILD_DIR / ".staging"
MANIFEST    = STAGING_DIR / "manifest.json"


def run(cmd: list[str], **kwargs) -> subprocess.CompletedProcess:
    log.info("+ %s", " ".join(str(c) for c in cmd))
    return subprocess.run(cmd, check=True, **kwargs)


def _hold(reason: str, summary: str, risk: str = "") -> dict:
    """Structured hold record for the failed map (carried into the metric)."""
    return {"reason": reason, "risk": risk, "summary": summary}


def _esc(s) -> str:
    """Escape a Prometheus label value (backslash, quote, newlines)."""
    return (str(s).replace("\\", "\\\\").replace('"', '\\"')
            .replace("\n", " ").replace("\r", " "))


def aur_version(pkg: str) -> str | None:
    """Return the current AUR version string, or None if not found."""
    r = subprocess.run(
        ["aur", "search", "--raw", pkg],
        capture_output=True, text=True,
    )
    for line in r.stdout.splitlines():
        if line.startswith("Version:"):
            return line.split(":", 1)[1].strip()
    return None


def installed_version(pkg: str) -> str | None:
    """Return the version already in the local repo db, or None."""
    db = REPO_DIR / f"{REPO_NAME}.db.tar.gz"
    if not db.exists():
        return None
    r = subprocess.run(
        ["tar", "-tzf", str(db)],
        capture_output=True, text=True,
    )
    for entry in r.stdout.splitlines():
        # Entries look like: pkgname-1.2.3-1/
        name, *rest = entry.rstrip("/").rsplit("-", 2)
        if name == pkg and len(rest) == 2:
            return "-".join(rest)
    return None


def refresh_system() -> None:
    """Sync + upgrade the build container's pacman db so `makepkg -s` installs
    current makedep versions. The image's baked db (a cached Docker layer) goes
    stale and 404s on packages the mirrors have since rotated. The container is
    ephemeral, so a full -Syu each run is cheap insurance against partial-
    upgrade breakage.
    """
    run(["sudo", "pacman", "-Syu", "--noconfirm"])


def fetch_pkgbuild(pkg: str, source: str | None, pkg_dir: Path) -> Path:
    """Fetch PKGBUILD into pkg_dir and return the package subdirectory.

    If source (a git URL) is given the PKGBUILD is cloned from it instead of
    fetched from the AUR -- this lets us mirror first-party packages (e.g. pac)
    that live in our own git, not the AUR.
    """
    if source:
        run(["git", "clone", "--depth", "1", source, pkg], cwd=pkg_dir)
    else:
        run(["aur", "fetch", pkg], cwd=pkg_dir)
    return pkg_dir / pkg


def build_fetched(pkg_subdir: Path) -> list[Path]:
    """Build from an already-fetched PKGBUILD directory."""
    run(
        ["makepkg", "-s", "--noconfirm", "--noprogressbar", "--needed"],
        cwd=pkg_subdir,
    )
    return list(pkg_subdir.glob("*.pkg.tar.zst"))


# Forced-tool schema so the model MUST return a valid structured verdict.
# (Parsing free-form text was brittle -- a non-JSON reply held safe packages
# as false positives. Tool use guarantees the shape.)
_VERDICT_TOOL = {
    "name": "report_verdict",
    "description": "Report the security verdict for the reviewed PKGBUILD.",
    "input_schema": {
        "type": "object",
        "properties": {
            "safe": {"type": "boolean", "description": "false ONLY for HIGH or CRITICAL risk"},
            "risk": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
            "findings": {"type": "array", "items": {"type": "string"},
                         "description": "specific concerns; empty if none"},
            "summary": {"type": "string", "description": "one-sentence verdict"},
        },
        "required": ["safe", "risk", "summary"],
    },
}


def claude_scan_pkgbuild(pkg_subdir: Path, pkg: str) -> dict:
    """Scan the WHOLE package recipe with Claude for suspicious/malicious content.

    Reviews every file the maintainer committed -- PKGBUILD, .SRCINFO, .install
    scriptlets (which run as ROOT on the client at install time), and any in-tree
    .patch/.diff or helper scripts -- not just the PKGBUILD, since .install hooks
    and patches are AUR attack vectors that never show up in the PKGBUILD text or
    a CVE scan.

    Returns a verdict dict {safe, risk, findings, summary, reason}. `reason` is
    None when safe; otherwise "pkgbuild" for a genuine HIGH/CRITICAL finding or
    "scan_error" for a scan failure. FAILS CLOSED: a missing API key, missing
    SDK, or any API/format error HOLDS the package -- the gate never silently
    no-ops. Distinguishes a real finding from a scan failure for operators.
    """
    # Fail closed: no scanner == no build. A control that disappears when the
    # secret is absent is no control.
    if not ANTHROPIC_API_KEY or not _HAS_ANTHROPIC:
        return {"safe": False, "risk": "critical", "findings": [],
                "summary": "scan unavailable: ANTHROPIC_API_KEY missing or SDK absent",
                "reason": "scan_error"}

    pkgbuild = pkg_subdir / "PKGBUILD"
    if not pkgbuild.exists():
        return {"safe": False, "risk": "critical", "findings": [],
                "summary": "no PKGBUILD found in source", "reason": "scan_error"}

    # Ingest every committed recipe file (the AUR checkout, before makepkg runs,
    # so no downloaded sources yet). Skip VCS metadata and binaries; cap per-file
    # and in total so a huge committed blob can't blow the context.
    parts, total = [], 0
    for p in sorted(pkg_subdir.rglob("*")):
        if not p.is_file() or ".git" in p.parts:
            continue
        try:
            raw = p.read_bytes()
        except OSError:
            continue
        if b"\x00" in raw[:4096]:  # binary -- not a script/patch we can read
            continue
        text = raw.decode("utf-8", errors="replace")[:16384]
        parts.append(f"--- {p.relative_to(pkg_subdir)} ---\n{text}")
        total += len(text)
        if total >= 131072:  # 128 KiB total budget
            break
    content = "\n\n".join(parts)

    system_prompt = (
        "You are a security auditor reviewing the COMPLETE recipe of an Arch Linux AUR package "
        "for supply-chain threats. You are given every file the maintainer committed -- the "
        "PKGBUILD, .SRCINFO, any .install scriptlets, and any in-tree patches/diffs or helper "
        "scripts. Review ALL of them, then call the report_verdict tool.\n\n"
        "Treat these as HIGH or CRITICAL:\n"
        "- .install scriptlets (post_install/post_upgrade/pre_install/etc): these run as ROOT on "
        "the client at install time. Flag any network access, downloads, piping to a shell, writes "
        "outside the package's own files, user/cron/systemd-timer creation that phones home, or "
        "obfuscation.\n"
        "- In-tree .patch/.diff files that introduce backdoors, credential/key exfiltration, "
        "network callbacks, or that weaken security checks in the upstream source.\n"
        "- PKGBUILD prepare()/build()/package(): network downloads not declared in source=(), "
        "curl|bash, eval of encoded strings, base64 -d | sh, writes outside $pkgdir, source URLs "
        "from domains unrelated to the package, exfiltration of credentials/keys/shadow/passwd, "
        "setuid on unusual binaries.\n\n"
        "MEDIUM (informational): sudo in build/package functions; undeclared but seemingly benign "
        "post-install network calls.\n\n"
        "LOW / SAFE: standard makepkg patterns, ordinary build steps, conventional .install hooks.\n\n"
        "Set safe=false ONLY for HIGH or CRITICAL risk. MEDIUM is informational. In 'findings', "
        "name the specific file and construct."
    )

    try:
        client = _anthropic.Anthropic(api_key=ANTHROPIC_API_KEY)
        message = client.messages.create(
            model="claude-haiku-4-5-20251001",
            max_tokens=1024,
            system=system_prompt,
            tools=[_VERDICT_TOOL],
            tool_choice={"type": "tool", "name": "report_verdict"},
            messages=[{"role": "user", "content": f"Package: {pkg}\n\n{content}"}],
        )
        verdict = next((b.input for b in message.content
                        if getattr(b, "type", None) == "tool_use"), None)
        if not verdict:
            return {"safe": False, "risk": "critical", "findings": [],
                    "summary": "model returned no verdict", "reason": "scan_error"}

        safe = bool(verdict.get("safe", False))
        risk = verdict.get("risk", "low")
        findings = verdict.get("findings", []) or []
        summary = verdict.get("summary", "")
        for finding in findings:
            log.info("Claude [%s] %s: %s", risk.upper(), pkg, finding)
        log.info("Claude recipe scan %s: risk=%s safe=%s -- %s", pkg, risk, safe, summary)
        return {"safe": safe, "risk": risk, "findings": findings, "summary": summary,
                "reason": None if safe else "pkgbuild"}
    except Exception as exc:
        log.error("Claude recipe scan error for %s (holding): %s", pkg, exc)
        return {"safe": False, "risk": "error", "findings": [],
                "summary": f"scan error: {exc}"[:200], "reason": "scan_error"}


def trivy_scan(artifact: Path) -> bool:
    """Extract the package and scan its contents. Returns True if clean.

    Trivy must scan the EXTRACTED tree, not the .pkg.tar.zst itself: pointed
    at the tarball it finds num=0 language files and scans nothing (a silent
    pass). Extracting lets Trivy see the actual supply-chain surface --
    bundled language deps (npm/pip/go/cargo/jars), Go/Rust binaries via SCA,
    and embedded secrets. Fails closed: any extraction/scan error holds the
    package rather than letting it through unscanned.
    """
    try:
        with tempfile.TemporaryDirectory(dir=BUILD_DIR) as tmp:
            subprocess.run(
                ["bsdtar", "-xpf", str(artifact), "-C", tmp],
                check=True,
            )
            result = subprocess.run([
                "trivy", "rootfs",
                "--exit-code", "1",
                "--severity", FAIL_SEVS,
                "--scanners", "vuln,secret",
                "--no-progress",
                tmp,
            ])
        return result.returncode == 0
    except (subprocess.CalledProcessError, OSError) as exc:
        log.error("Trivy scan error for %s (holding): %s", artifact.name, exc)
        return False


def stage_artifacts(pkg: str, artifacts: list[Path]) -> None:
    """Move vetted artifacts into the staging area for the sign phase."""
    dest = STAGING_DIR / pkg
    dest.mkdir(parents=True, exist_ok=True)
    for artifact in artifacts:
        shutil.move(str(artifact), str(dest / artifact.name))


def sign_and_publish(artifacts: list[Path]) -> None:
    """GPG-sign each artifact and add to the pacman repo database."""
    REPO_DIR.mkdir(parents=True, exist_ok=True)
    db = REPO_DIR / f"{REPO_NAME}.db.tar.gz"

    for artifact in artifacts:
        dest = REPO_DIR / artifact.name
        # shutil.move (not Path.rename): staging is the build emptyDir and /repo
        # is NFS, so os.rename fails with EXDEV (cross-device link). shutil.move
        # falls back to copy+unlink across filesystems.
        shutil.move(str(artifact), str(dest))

        run([
            "gpg", "--batch", "--yes",
            "--local-user", GPG_KEY_ID,
            "--detach-sign", str(dest),
        ])
        log.info("Signed: %s", dest.name)

    run([
        "repo-add", "--sign", "--key", GPG_KEY_ID,
        str(db),
        *[str(REPO_DIR / a.name) for a in artifacts],
    ])


def prune_repo(approved: set[str]) -> None:
    """Remove repo packages whose base name isn't in the approved set.

    Keeps the mirror in sync with the allowlist so packages that were
    removed from it (or built during earlier testing) stop being served.
    A package's -debug variant is kept iff its base is approved. The DB is
    re-signed atomically via repo-remove --sign.

    Note: split packages whose pkgname differs from the pkgbase are only
    retained if that pkgname is itself in the allowlist -- which holds here
    because the allowlist is generated from installed pkgnames (pacman -Qmq).
    """
    db = REPO_DIR / f"{REPO_NAME}.db.tar.gz"
    if not db.exists():
        return

    r = subprocess.run(["tar", "-tzf", str(db)], capture_output=True, text=True)
    # DB entries look like "pkgname-version-rel/"; pkgname is everything
    # before the last two hyphen-separated fields (version, rel).
    db_pkgnames = {
        e.rstrip("/").rsplit("-", 2)[0]
        for e in r.stdout.splitlines()
        if e.endswith("/")
    }

    stale = [
        name for name in db_pkgnames
        if (name[:-6] if name.endswith("-debug") else name) not in approved
    ]
    if not stale:
        return

    log.info("Pruning %d stale package(s): %s", len(stale), ", ".join(sorted(stale)))
    run(["repo-remove", "--sign", "--key", GPG_KEY_ID, str(db), *sorted(stale)])

    # Delete the orphaned package files + signatures from disk.
    for name in stale:
        for f in REPO_DIR.glob(f"{name}-*.pkg.tar.zst"):
            if f.name.rsplit("-", 3)[0] == name:  # guard against prefix over-match
                f.unlink()
                sig = f.with_name(f.name + ".sig")
                if sig.exists():
                    sig.unlink()


def push_metrics(total: int, skipped: int, failed: dict[str, dict]) -> None:
    """Push build result metrics to Prometheus Pushgateway."""
    if not PUSHGATEWAY_URL:
        return

    succeeded = total - skipped - len(failed)
    lines = [
        "# HELP aur_mirror_package_held Package held back from the mirror (1=held)",
        "# TYPE aur_mirror_package_held gauge",
    ]
    for pkg, info in failed.items():
        pkgname = _esc(pkg)
        reason  = _esc(info.get("reason", ""))
        risk    = _esc(info.get("risk", ""))
        summary = _esc(info.get("summary", ""))[:200]
        lines.append(
            f'aur_mirror_package_held{{package="{pkgname}",reason="{reason}",'
            f'risk="{risk}",summary="{summary}"}} 1'
        )

    lines += [
        "# HELP aur_mirror_last_run_timestamp_seconds Unix timestamp of the last build run",
        "# TYPE aur_mirror_last_run_timestamp_seconds gauge",
        f"aur_mirror_last_run_timestamp_seconds {int(time.time())}",

        "# HELP aur_mirror_last_run_success 1 if no packages failed in the last run",
        "# TYPE aur_mirror_last_run_success gauge",
        f"aur_mirror_last_run_success {0 if failed else 1}",

        "# HELP aur_mirror_packages_total Total approved packages in the allowlist",
        "# TYPE aur_mirror_packages_total gauge",
        f"aur_mirror_packages_total {total}",

        "# HELP aur_mirror_packages_succeeded_total Packages successfully built in the last run",
        "# TYPE aur_mirror_packages_succeeded_total gauge",
        f"aur_mirror_packages_succeeded_total {succeeded}",

        "# HELP aur_mirror_packages_skipped_total Packages skipped (already up to date) in the last run",
        "# TYPE aur_mirror_packages_skipped_total gauge",
        f"aur_mirror_packages_skipped_total {skipped}",

        "# HELP aur_mirror_packages_held_total Packages held back in the last run",
        "# TYPE aur_mirror_packages_held_total gauge",
        f"aur_mirror_packages_held_total {len(failed)}",
    ]

    body = "\n".join(lines) + "\n"
    url = f"{PUSHGATEWAY_URL.rstrip('/')}/metrics/job/aur-mirror"
    req = urllib.request.Request(url, data=body.encode(), method="PUT")
    req.add_header("Content-Type", "text/plain; version=0.0.4")
    try:
        urllib.request.urlopen(req)
        log.info("Metrics pushed to Pushgateway (%d held)", len(failed))
    except Exception as exc:
        log.warning("Failed to push metrics to Pushgateway: %s", exc)


def run_build_phase() -> int:
    """Fetch, scan, build, and Trivy-check each package; stage what passes.

    Records per-package outcomes in MANIFEST and always returns 0 (unless the
    allowlist itself can't be read) so the sign phase still runs and publishes
    the packages that passed. NO GPG key is present in this phase.
    """
    with ALLOWLIST.open() as f:
        config = yaml.safe_load(f)

    packages = [p for p in config.get("packages", []) if p.get("approved") is True]
    log.info("Allowlist: %d approved packages", len(packages))

    failed: dict[str, dict] = {}  # pkg -> {reason, risk, summary}
    staged: list[str] = []
    skipped = 0

    STAGING_DIR.mkdir(parents=True, exist_ok=True)

    # Refresh the pacman db once up front so makepkg -s resolves current
    # makedep versions instead of 404ing on the stale baked-in image db.
    try:
        refresh_system()
    except subprocess.CalledProcessError as exc:
        log.warning("System refresh failed (continuing): %s", exc)

    for entry in packages:
        pkg = entry["name"]
        source = entry.get("source")  # git URL for first-party (non-AUR) packages
        log.info("-- Processing: %s --", pkg)

        # Git-sourced packages have no AUR version; always (re)build them.
        if not source:
            aur_ver = aur_version(pkg)
            repo_ver = installed_version(pkg)
            if aur_ver and aur_ver == repo_ver:
                log.info("Up to date (%s), skipping.", aur_ver)
                skipped += 1
                continue

        pkg_dir = BUILD_DIR / pkg
        pkg_dir.mkdir(parents=True, exist_ok=True)
        try:
            # 1. Fetch PKGBUILD (does not execute any package code)
            try:
                pkg_subdir = fetch_pkgbuild(pkg, source, pkg_dir)
            except subprocess.CalledProcessError:
                log.error("Fetch FAILED for %s", pkg)
                failed[pkg] = _hold("build_error", "PKGBUILD fetch failed")
                continue

            # 2. Claude PKGBUILD scan -- before any code runs
            verdict = claude_scan_pkgbuild(pkg_subdir, pkg)
            if not verdict["safe"]:
                log.error("Held by Claude scan (%s) for %s: %s",
                          verdict["reason"], pkg, verdict["summary"])
                failed[pkg] = _hold(verdict["reason"], verdict["summary"], verdict.get("risk", ""))
                continue

            # 3. Build
            try:
                artifacts = build_fetched(pkg_subdir)
            except subprocess.CalledProcessError:
                log.error("Build FAILED for %s", pkg)
                failed[pkg] = _hold("build_error", "makepkg build failed")
                continue

            # 4. Trivy scan on the built artifacts
            clean = True
            for artifact in artifacts:
                if not trivy_scan(artifact):
                    log.error(
                        "Trivy found %s vulnerabilities in %s -- NOT publishing",
                        FAIL_SEVS, artifact.name,
                    )
                    clean = False

            if not clean:
                failed[pkg] = _hold("trivy", f"Trivy found {FAIL_SEVS} CVE or embedded secret")
                continue

            # 5. Stage vetted artifacts for the sign phase (no signing here)
            stage_artifacts(pkg, artifacts)
            staged.append(pkg)
            log.info("Staged for signing: %s", pkg)
        finally:
            # Reclaim scratch: drop this package's build tree so peak /build
            # usage stays at ~one build tree plus the staged artifacts.
            shutil.rmtree(pkg_dir, ignore_errors=True)

    manifest = {
        "total": len(packages),
        "skipped": skipped,
        "failed": failed,
        "staged": staged,
        "approved": [entry["name"] for entry in packages],
    }
    MANIFEST.write_text(json.dumps(manifest))
    log.info(
        "Build phase done: %d staged, %d skipped, %d held",
        len(staged), skipped, len(failed),
    )
    return 0


def run_sign_phase() -> int:
    """Sign and publish staged artifacts, prune the repo, push metrics.

    Consumes the manifest written by the build phase. This is the only phase
    that holds the GPG key, and it never executes PKGBUILD code.
    """
    if not MANIFEST.exists():
        log.error("No staging manifest at %s -- build phase produced nothing", MANIFEST)
        return 1

    manifest = json.loads(MANIFEST.read_text())
    total    = manifest["total"]
    skipped  = manifest["skipped"]
    failed   = dict(manifest["failed"])
    staged   = manifest["staged"]
    approved = set(manifest["approved"])

    for pkg in staged:
        artifacts = sorted((STAGING_DIR / pkg).glob("*.pkg.tar.zst"))
        if not artifacts:
            log.error("No staged artifacts for %s (held)", pkg)
            failed[pkg] = _hold("publish_error", "no staged artifacts found")
            continue
        try:
            sign_and_publish(artifacts)
            log.info("Published: %s", pkg)
        except (subprocess.CalledProcessError, OSError) as exc:
            # Never let one package's publish error abort the whole run.
            log.error("Publish FAILED for %s: %s", pkg, exc)
            failed[pkg] = _hold("publish_error", str(exc)[:200])

    try:
        prune_repo(approved)
    except (subprocess.CalledProcessError, OSError) as exc:
        log.error("Repo prune failed: %s", exc)

    push_metrics(total=total, skipped=skipped, failed=failed)
    shutil.rmtree(STAGING_DIR, ignore_errors=True)

    if failed:
        log.error("Failed packages: %s", ", ".join(failed))
        return 1

    log.info("All packages processed successfully.")
    return 0


def main() -> int:
    if BUILD_PHASE == "build":
        return run_build_phase()
    if BUILD_PHASE == "sign":
        return run_sign_phase()
    # "all": run both in one process -- local/manual use only, no key isolation.
    rc = run_build_phase()
    return rc if rc != 0 else run_sign_phase()


if __name__ == "__main__":
    sys.exit(main())
